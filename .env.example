# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hospital_ai_assistant

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# JWT Configuration
JWT_SECRET_KEY=your_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Server Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Doctor Recommendation
TOP_DOCTORS_COUNT=5

# LangSmith Configuration (for observability and tracing)
# Get your API key from: https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=hospital-ai-assistant
